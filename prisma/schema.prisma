generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  MENTOR
  ADMIN
}

enum SubscriptionTier {
  FREE
  BASIC
  PRO
  CRASH_COURSE
}

enum ExamType {
  IBA
  MEDICAL
  B_UNIT
  C_UNIT
  D_UNIT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ
}

enum QuestionLanguage {
  EN
  BN
  MIXED
}

enum AttemptMode {
  QUICK_PRACTICE
  CHAPTER_DRILL
  MOCK_TEST
  WEAK_AREA
  RAPID_REVISION
  CUSTOM
}

enum AiUseCase {
  WRONG_ANSWER_EXPLANATION
  FEYNMAN_GAP_DETECTION
  SOCRATIC_CHAIN
  FIRST_PRINCIPLES
  MOCK_TEST_SUMMARY
}

enum OtpPurpose {
  SIGN_IN
  PASSWORD_RESET
}

enum AuditAction {
  OTP_REQUESTED
  OTP_VERIFIED
  OTP_FAILED
  SESSION_CREATED
  SESSION_REVOKED
  GOOGLE_OAUTH_STARTED
  GOOGLE_OAUTH_COMPLETED
}

enum AssessmentStatus {
  UNATTEMPTED
  FAILED
  PASSED
  SKIPPED
}

enum BattleResult {
  WIN
  LOSS
  DRAW
}

enum EventType {
  OLYMPIAD
  WORKSHOP
  MENTOR_LIVE
  MOCK_CONTEST
}

enum EventRegistrationStatus {
  WAITLISTED
  CONFIRMED
  CANCELLED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
}

model User {
  id              String             @id @default(cuid())
  phone           String?            @unique
  email           String?            @unique
  name            String?
  avatarUrl       String?
  role            UserRole           @default(STUDENT)
  subscriptionTier SubscriptionTier  @default(FREE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lastLoginAt     DateTime?

  accounts        AuthAccount[]
  sessions        Session[]
  otpChallenges   OtpChallenge[]
  emailOtpChallenges EmailOtpChallenge[]
  studentProfile  StudentProfile?
  mentorProfile   MentorProfile?
  attempts        QuestionAttempt[]
  mockTests       MockTestAttempt[]
  subscriptions   Subscription[]
  aiInteractions  AiInteraction[]
  xpLedger        XpLedger[]
  streakLedger    StreakLedger[]
  achievements    UserAchievement[]
  auditLogs       AuditLog[]
  assessmentRecords AssessmentRecord[]
  learningProgress  LearningProgress[]
  personalNotes     PersonalNote[]
  communityPosts    CommunityPost[]
  teacherCourses    TeacherCourse[]
  interviewSessions InterviewSession[]
  createdBattles    Battle[]           @relation("BattleCreator")
  opponentBattles   Battle[]           @relation("BattleOpponent")
  friendships       Friendship[]       @relation("FriendshipUser")
  friendedBy        Friendship[]       @relation("FriendshipFriend")
  eventRegistrations EventRegistration[]

  @@index([role])
  @@index([subscriptionTier])
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  accessTokenHash   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OtpChallenge {
  id           String     @id @default(cuid())
  userId       String?
  phone        String
  purpose      OtpPurpose @default(SIGN_IN)
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int        @default(0)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model EmailOtpChallenge {
  id           String     @id @default(cuid())
  userId       String?
  email        String
  purpose      OtpPurpose @default(SIGN_IN)
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int        @default(0)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

model StudentProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  examTarget      ExamType?
  targetExamDate  DateTime?
  prepLevel       String?
  preferredLocale String    @default("en-BD")
  dailyQuestionLimit Int    @default(10)
  topicEnergy     Int       @default(100)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExamTarget {
  id          String    @id @default(cuid())
  type        ExamType  @unique
  name        String
  description String
  timeLimitMinutes Int?
  questionCount    Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subjects Subject[]
}

model Subject {
  id           String     @id @default(cuid())
  examTargetId String
  name         String
  slug         String
  description  String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  examTarget ExamTarget @relation(fields: [examTargetId], references: [id], onDelete: Cascade)
  chapters   Chapter[]
  questions  Question[]
  teacherCourses TeacherCourse[]

  @@unique([examTargetId, slug])
  @@index([examTargetId])
}

model Chapter {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  slug      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@unique([subjectId, slug])
  @@index([subjectId])
}

model Topic {
  id        String   @id @default(cuid())
  chapterId String
  name      String
  slug      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter   Chapter            @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions Question[]
  promptVersions PromptVersion[]
  assessmentRecords AssessmentRecord[]
  learningProgress  LearningProgress[]
  personalNotes     PersonalNote[]
  communityPosts    CommunityPost[]
  interviewSessions InterviewSession[]

  @@unique([chapterId, slug])
  @@index([chapterId])
}

model Question {
  id              String           @id @default(cuid())
  examType        ExamType
  subjectId       String
  topicId         String?
  text            String
  type            QuestionType     @default(MCQ)
  difficulty      Difficulty       @default(MEDIUM)
  year            Int
  source          String?
  language        QuestionLanguage @default(MIXED)
  explanation     String
  imageUrl        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  subject  Subject          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  topic    Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  options  QuestionOption[]
  attempts QuestionAttempt[]
  aiInteractions AiInteraction[]

  @@index([examType, difficulty])
  @@index([subjectId])
  @@index([topicId])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempts QuestionAttempt[] @relation("SelectedOption")

  @@unique([questionId, label])
  @@index([questionId])
}

model QuestionAttempt {
  id               String      @id @default(cuid())
  userId           String
  questionId       String
  selectedOptionId String?
  mode             AttemptMode @default(QUICK_PRACTICE)
  isCorrect        Boolean
  timeTakenSeconds Int?
  xpEarned         Int         @default(0)
  createdAt        DateTime    @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption? @relation("SelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([questionId])
  @@index([mode])
}

model MockTestAttempt {
  id               String   @id @default(cuid())
  userId           String
  examType         ExamType
  score            Int
  totalQuestions   Int
  timeTakenSeconds Int
  rank             Int?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([examType, createdAt])
}

model Subscription {
  id        String           @id @default(cuid())
  userId    String
  tier      SubscriptionTier
  startsAt  DateTime         @default(now())
  endsAt    DateTime?
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model PromptVersion {
  id          String    @id @default(cuid())
  useCase     AiUseCase
  version     Int
  title       String
  body        String
  topicId     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  topic Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  interactions AiInteraction[]

  @@unique([useCase, version])
  @@index([useCase, isActive])
}

model AiInteraction {
  id              String    @id @default(cuid())
  userId          String
  questionId      String?
  promptVersionId String?
  useCase         AiUseCase
  provider        String
  model           String
  inputHash       String
  outputText      String?
  rating          Int?
  tokenIn         Int?
  tokenOut        Int?
  costMicros      Int?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question?      @relation(fields: [questionId], references: [id], onDelete: SetNull)
  promptVersion PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([userId, useCase, createdAt])
  @@index([inputHash, useCase])
  @@index([expiresAt])
}

model XpLedger {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StreakLedger {
  id        String   @id @default(cuid())
  userId    String
  studyDate DateTime
  protected Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, studyDate])
  @@index([userId, studyDate])
}

model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String?
  xpReward    Int      @default(0)
  createdAt   DateTime @default(now())

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model MentorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  university      String
  department      String
  examPassed      ExamType
  subjectsOffered String[]
  rateChat        Int
  rateVideo       Int
  rating          Float    @default(0)
  sessionsCount   Int      @default(0)
  verified        Boolean  @default(false)
  bio             String?
  shareSlug       String   @unique
  reportCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model AssessmentRecord {
  id              String           @id @default(cuid())
  userId          String
  topicId         String
  feynmanScore    Int              @default(0)
  feynmanAttempts Int              @default(0)
  feynmanStatus   AssessmentStatus @default(UNATTEMPTED)
  socraticScore   Int              @default(0)
  socraticAttempts Int             @default(0)
  socraticStatus  AssessmentStatus @default(UNATTEMPTED)
  firstPrinciplesScore Int         @default(0)
  firstPrinciplesStatus AssessmentStatus @default(UNATTEMPTED)
  updatedAt       DateTime         @updatedAt
  createdAt       DateTime         @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([topicId])
}

model LearningProgress {
  id            String           @id @default(cuid())
  userId        String
  topicId       String
  status        AssessmentStatus @default(UNATTEMPTED)
  energySpent   Int              @default(0)
  xpEarned      Int              @default(0)
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, status])
}

model Battle {
  id             String       @id @default(cuid())
  creatorId      String
  opponentId     String?
  opponentName   String
  subject        String
  result         BattleResult @default(DRAW)
  creatorScore   Int          @default(0)
  opponentScore  Int          @default(0)
  pointsGained   Int          @default(0)
  createdAt      DateTime     @default(now())

  creator  User  @relation("BattleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  opponent User? @relation("BattleOpponent", fields: [opponentId], references: [id], onDelete: SetNull)

  @@index([creatorId, createdAt])
  @@index([subject, createdAt])
}

model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("FriendshipUser", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
}

model Event {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  type        EventType
  description String
  startsAt    DateTime
  venue       String?
  price       Int       @default(0)
  capacity    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  registrations EventRegistration[]

  @@index([type, startsAt])
}

model EventRegistration {
  id        String                  @id @default(cuid())
  eventId   String
  userId    String
  status    EventRegistrationStatus @default(WAITLISTED)
  createdAt DateTime                @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model PersonalNote {
  id        String   @id @default(cuid())
  userId    String
  topicId   String?
  title     String
  content   String
  tags      String[] @default([])
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([topicId])
  @@unique([userId, title])
}

model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  topicId   String?
  title     String
  body      String
  tags      String[] @default([])
  upvotes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([topicId])
  @@index([userId])
  @@unique([userId, title])
}

model TeacherCourse {
  id          String       @id @default(cuid())
  teacherId   String
  subjectId   String?
  title       String
  description String
  status      CourseStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  teacher User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([teacherId, status])
  @@index([subjectId])
  @@unique([teacherId, title])
}

model InterviewSession {
  id           String          @id @default(cuid())
  userId       String
  topicId      String?
  status       InterviewStatus @default(IN_PROGRESS)
  mode         String          @default("STANDARD")
  transcript   Json            @default("[]")
  score        Int             @default(0)
  readiness    String          @default("Not Ready")
  strengths    String[]        @default([])
  improvements String[]        @default([])
  createdAt    DateTime        @default(now())
  completedAt  DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([topicId])
}
